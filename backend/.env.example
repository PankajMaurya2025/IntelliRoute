# Supabase PostgreSQL connection string (Project Settings -> Database -> Connection string -> URI).
# Use the "Connection pooling" string for app traffic (port 6543) if your plan provides one,
# or the direct connection string (port 5432) for local dev / migrations.
# psycopg2 needs the postgresql:// scheme rewritten to postgresql+psycopg2:// and sslmode=require.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

SECRET_KEY=change_me_to_a_random_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MAP_API_KEY=

# Optional: a SEPARATE, disposable Postgres database for `pytest` to use.
# Its tables get dropped and recreated on every test run. If left unset,
# tests fall back to DATABASE_URL above — which means they'll wipe your
# real database. Strongly recommended to set this to a different DB/project.
TEST_DATABASE_URL=
